# CardPromo LK — Frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local with real keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose in browser code
# This key is constrained by Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL for canonical URLs, OG tags, and sitemap generation.
# Use your production domain in CI (e.g. https://cardpromo.lk).
# Use http://localhost:5173 for local development.
VITE_APP_BASE_URL=http://localhost:5173

# ── IMPORTANT ─────────────────────────────────────────────────────────────────
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here.
# The service role key bypasses RLS and belongs only in:
#   - scrapers/.env  (local scraper runs)
#   - GitHub Actions secrets  (CI scraper runs)
