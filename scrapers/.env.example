# CardPromo LK — Scraper environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — bypasses RLS, only for the scraper
# Never expose this in frontend code or public repositories
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
